import DocsLayout from '@/layouts/DocsLayout.astro';
import { getDocEntry } from '@/lib/docs';
import { render } from 'astro:content';

const entry = await getDocEntry('zh', 'dsh-plugin');
if (!entry) throw new Error('dsh-plugin doc not found');
const { Content } = await render(entry);
---

<DocsLayout locale="zh" currentPath="/docs/dsh-plugin" title={entry.data.title} activeSlug="dsh-plugin">
  <article class="prose-docs">
    <Content />
  </article>
</DocsLayout>
